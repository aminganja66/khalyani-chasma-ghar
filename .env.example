# Copy to .env.local. These two values come from your Supabase project (Project Settings -> API).
# The publishable key is safe to use in the browser; never put the secret/service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
